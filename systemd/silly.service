[Unit]
Description=silly the self hosted spotify playlist downloader
After=network.target
# your music folder
ConditionPathExists=/home/trash/music

[Service]
User=root
Group=root
Type=simple
CPUQuota=80%
PermissionsStartOnly=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment="FFMPEG=/usr/bin/ffmpeg"
Environment="FFPROBE=/usr/bin/ffprobe"

MemoryMax=30%
MemorySwapMax=50%
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true

# move silly to appropriate path
ExecStart=/usr/local/bin/silly

[Install]
WantedBy=multi-user.target
